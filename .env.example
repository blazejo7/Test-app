# Copy to .env and fill in. These are read at build time by Expo, so they must
# be prefixed with EXPO_PUBLIC_. The anon key is safe to ship to the client —
# Row Level Security (see supabase/migrations/0001_init.sql) is what protects data.

# For a local Supabase stack (`npx supabase start`), use the printed API URL/key.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
